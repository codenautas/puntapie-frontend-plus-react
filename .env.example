# Configuración de desarrollo (copiar a .env). La aplicación usa el cliente de backend-plus (puenteBP), que solo funciona
# en el mismo origen que el backend: Vite sirve la aplicación bajo <base-url>/react/ y reenvía <base-url> al backend.
# Abrir http://localhost:8080/<base-url>/react/ (ejemplo: http://localhost:8080/ggs2026/react/)
# En producción el backend sirve la aplicación en <base-url>/react/ y la misma VITE_BACKEND_URL (ruta relativa) sigue valiendo.
VITE_BASE=/ggs2026/react/
VITE_BACKEND_URL=/ggs2026
PROXY_BACKEND=http://localhost:3044
